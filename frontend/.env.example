# Copy to .env.local to override locally. Never put secrets in VITE_* variables:
# everything prefixed with VITE_ is compiled into the public JavaScript bundle.

# true = use the in-browser mock backend (demo data). false = call the real API.
VITE_USE_MOCKS=false

# Dev server only: where `npm run dev` proxies /api requests when mocks are off.
VITE_API_PROXY_TARGET=http://localhost:8000
