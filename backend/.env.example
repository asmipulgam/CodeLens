# Copy to .env for local development:  cp .env.example .env
# Production sets these as real environment variables (secrets from Azure Key Vault), never a file.

CODELENS_ENVIRONMENT=development
# Where people open CodeLens (the Vite dev server proxies /api to this backend).
CODELENS_PUBLIC_URL=http://localhost:5173
# Plain http on localhost, so cookies can't be Secure. Must be true (the default) in production.
CODELENS_COOKIE_SECURE=false

CODELENS_DATABASE_URL=postgresql+psycopg://codelens:codelens@localhost:5433/codelens
CODELENS_REDIS_URL=redis://localhost:6379/0

# Sign-in: the local Keycloak from docker-compose.yml. Swap for the company provider later.
CODELENS_OIDC_ISSUER=http://localhost:8080/realms/codelens
CODELENS_OIDC_CLIENT_ID=codelens
CODELENS_OIDC_CLIENT_SECRET=dev-only-change-me
CODELENS_OIDC_GROUPS_CLAIM=groups
# Identity-provider group -> CodeLens roles (JSON).
CODELENS_GROUP_ROLE_MAP={"codelens-business":["business"],"codelens-analysts":["analyst"],"codelens-admins":["admin"],"codelens-auditors":["auditor"]}
# Optional "Sign in with Google" for specific approved addresses (see README "Sign in with Google").
# Leave the client id empty to hide the button. Google accounts can never be admins.
CODELENS_GOOGLE_CLIENT_ID=
CODELENS_GOOGLE_CLIENT_SECRET=
CODELENS_GOOGLE_USERS={}
# Example: CODELENS_GOOGLE_USERS={"someone@gmail.com":["business"],"contractor@gmail.com":["analyst"]}

# Roles every employee gets. Empty = only people in a mapped group can sign in.
CODELENS_DEFAULT_ROLES=[]

# Data-source passwords and keys. Production: azure_key_vault + CODELENS_KEY_VAULT_URL (managed identity).
# Development: "local" encrypts them into the app database with this key. Generate your own with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CODELENS_SECRET_STORE=local
CODELENS_LOCAL_SECRETS_KEY=
# CODELENS_KEY_VAULT_URL=https://<vault-name>.vault.azure.net
# Production must set this to false (blocks data sources on localhost / link-local addresses).
CODELENS_ALLOW_LOCAL_SOURCE_HOSTS=true

# Answering questions. "standin" works without AI for common questions (counts, totals, top N, by month…).
# Switch to azure_openai once the Azure OpenAI deployment exists (the backend signs in with its managed
# identity, or `az login` locally — no API key).
CODELENS_LLM_PROVIDER=standin
# CODELENS_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# CODELENS_AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# CODELENS_AZURE_OPENAI_API_VERSION=2024-10-21
# false = the AI never sees result rows; summaries are written from a template instead.
CODELENS_AI_SHARES_RESULT_ROWS=true
CODELENS_CONFIRM_ROWS_THRESHOLD=5000000
CODELENS_QUESTIONS_PER_MINUTE=20

# Development only: skip the sign-in page and sign everyone in as "Local Developer" with these roles.
# The app refuses to start in production with this on.
CODELENS_DEV_AUTO_LOGIN=false
CODELENS_DEV_AUTO_LOGIN_ROLES=["admin","analyst"]

CODELENS_SESSION_IDLE_SECONDS=900
CODELENS_SESSION_ABSOLUTE_SECONDS=28800
CODELENS_STEP_UP_MAX_AGE_SECONDS=1800
